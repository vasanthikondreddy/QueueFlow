# Copy to .env and fill in. NEVER commit the real .env file.
NODE_ENV=development
PORT=5000
# Local:  mongodb://127.0.0.1:27017/queueflow
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/queueflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/queueflow
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_MAX=20
